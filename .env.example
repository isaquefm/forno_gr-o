# DDI + DDD + número, apenas dígitos. Exemplo: 5511987654321
NEXT_PUBLIC_WHATSAPP_PHONE=5514997071115

# Senha de acesso ao Painel da Equipe (/admin)
ADMIN_PASSWORD=troque-esta-senha

# Opcional: ID de Cliente OAuth do Google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# Supabase (Project Settings -> API). NUNCA exponha a service role key no navegador.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
